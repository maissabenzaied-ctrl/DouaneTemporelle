<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F0E8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="30dp"
        android:paddingBottom="30dp">

        <!-- 1. Houni el en-tete mta3 l'application -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DOUANE TEMPORELLE"
            android:textColor="#A58B5E"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.24"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- 2. Houni el titre principal mta3 el formulaire -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ENREGISTREMENT DU\nVOYAGEUR"
            android:textColor="#17283D"
            android:textSize="25sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.01"
            android:layout_marginBottom="13dp" />

        <!-- 3. Houni el ligne decoratif -->
        <View
            android:layout_width="42dp"
            android:layout_height="2dp"
            android:background="#C6A66B"
            android:layout_gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- 4. Houni sous-titre mta3 el formulaire -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FORMULAIRE OFFICIEL DE VOYAGE TEMPOREL"
            android:textColor="#8C8579"
            android:textSize="8sp"
            android:letterSpacing="0.10"
            android:gravity="center"
            android:layout_marginBottom="25dp" />

        <!-- 5. Houni el carte principale elli fiha les informations -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_carte_hs"
            android:elevation="4dp">

            <!-- 6. Houni titre mta3 el carte -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Informations personnelles"
                android:textColor="#17283D"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:layout_marginBottom="12dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E3D9C7"
                android:layout_marginBottom="18dp" />

            <!-- 7. Houni label mta3 esm el voyageur -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NOM DU VOYAGEUR"
                android:textColor="#243B59"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.07"
                android:layout_marginBottom="8dp" />

            <!-- 8. Houni el voyageur yekteb esmou -->
            <EditText
                android:id="@+id/et_nom_hs"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_champ_hs"
                android:hint="Saisir le nom complet"
                android:textColor="#17283D"
                android:textColorHint="#918B80"
                android:textSize="12sp"
                android:singleLine="true"
                android:inputType="textCapWords"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="16dp" />

            <!-- 9. Houni label mta3 3am el naissance -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ANNÉE DE NAISSANCE"
                android:textColor="#243B59"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.07"
                android:layout_marginBottom="8dp" />

            <!-- 10. Houni el voyageur yekteb 3am elli tould fih -->
            <EditText
                android:id="@+id/et_naissance_hs"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_champ_hs"
                android:hint="Ex. : 2000"
                android:textColor="#17283D"
                android:textColorHint="#918B80"
                android:textSize="12sp"
                android:singleLine="true"
                android:inputType="number"
                android:maxLength="4"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="16dp" />

            <!-- 11. Houni label mta3 3am el destination -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ANNÉE DE DESTINATION"
                android:textColor="#243B59"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.07"
                android:layout_marginBottom="8dp" />

            <!-- 12. Houni el voyageur yekteb 3am elli bech yemchi fih -->
            <EditText
                android:id="@+id/et_destination_hs"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_champ_hs"
                android:hint="Ex. : 2149"
                android:textColor="#17283D"
                android:textColorHint="#918B80"
                android:textSize="12sp"
                android:singleLine="true"
                android:inputType="number"
                android:maxLength="4"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="16dp" />

            <!-- 13. Houni label mta3 motif el voyage -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MOTIF DU VOYAGE"
                android:textColor="#243B59"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.07"
                android:layout_marginBottom="8dp" />

            <!-- 14. Houni el voyageur yekhtar motif el voyage -->
            <Spinner
                android:id="@+id/sp_motif_hs"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_champ_hs"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:spinnerMode="dropdown"
                android:layout_marginBottom="20dp" />

            <!-- 15. Houni el bouton y3addi les informations lel verification -->
            <Button
                android:id="@+id/btn_inspecter_hs"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="INSPECTER LE PROFIL"
                android:textColor="#F7F4ED"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:background="@drawable/bg_bouton_hs"
                android:backgroundTint="@null"
                android:minHeight="52dp"
                android:padding="8dp" />

        </LinearLayout>

        <!-- 16. Houni el pied de page mta3 l'application -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SERVICE OFFICIEL DE CONTRÔLE TEMPOREL"
            android:textColor="#A58B5E"
            android:textSize="8sp"
            android:textStyle="bold"
            android:letterSpacing="0.09"
            android:gravity="center"
            android:layout_marginTop="22dp" />

    </LinearLayout>

</ScrollView>
