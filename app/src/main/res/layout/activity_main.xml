<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#263B35">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_margin="10dp"
        android:background="#F2EBDD"
        android:gravity="center_horizontal">

        <!-- 1. Titre principal -->
        <TextView
            android:id="@+id/tv_titre_hs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DOUANE TEMPORELLE"
            android:textColor="#263B35"
            android:textSize="25sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:gravity="center"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp" />

        <!-- 2. Sous-titre -->
        <TextView
            android:id="@+id/tv_sous_titre_hs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BUREAU DE CONTRÔLE DES VOYAGEURS TEMPORELS"
            android:textColor="#713F43"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:gravity="center"
            android:layout_marginBottom="22dp" />

        <!-- 3. Ligne decorative -->
        <View
            android:layout_width="65dp"
            android:layout_height="2dp"
            android:background="#B69A70"
            android:layout_marginBottom="28dp" />

        <!-- 4. Nom du voyageur -->
        <TextView
            android:id="@+id/tv_nom_label_hs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NOM DU VOYAGEUR"
            android:textColor="#263B35"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/et_nom_hs"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Saisir votre nom complet"
            android:inputType="textPersonName"
            android:textColor="#263B35"
            android:textColorHint="#8A8A80"
            android:textSize="15sp"
            android:backgroundTint="#B69A70"
            android:padding="12dp"
            android:layout_marginBottom="22dp" />

        <!-- 5. Annee de naissance -->
        <TextView
            android:id="@+id/tv_naissance_label_hs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ANNÉE DE NAISSANCE"
            android:textColor="#263B35"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/et_naissance_hs"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Exemple : 2002"
            android:inputType="number"
            android:textColor="#263B35"
            android:textColorHint="#8A8A80"
            android:textSize="15sp"
            android:backgroundTint="#B69A70"
            android:padding="12dp"
            android:layout_marginBottom="22dp" />

        <!-- 6. Annee de destination -->
        <TextView
            android:id="@+id/tv_destination_label_hs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ANNÉE DE DESTINATION"
            android:textColor="#263B35"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/et_destination_hs"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Exemple : 2150"
            android:inputType="number"
            android:textColor="#263B35"
            android:textColorHint="#8A8A80"
            android:textSize="15sp"
            android:backgroundTint="#B69A70"
            android:padding="12dp"
            android:layout_marginBottom="22dp" />

        <!-- 7. Motif du voyage -->
        <TextView
            android:id="@+id/tv_motif_label_hs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MOTIF DU VOYAGE"
            android:textColor="#263B35"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/sp_motif_hs"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="#B69A70"
            android:layout_marginBottom="30dp" />

        <!-- 8. Bouton inspection -->
        <Button
            android:id="@+id/btn_inspecter_hs"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="INSPECTER LE PROFIL"
            android:textStyle="bold"
            android:textSize="13sp"
            android:letterSpacing="0.04"
            android:textColor="#263B35"
            android:backgroundTint="#B69A70"
            android:minHeight="56dp"
            android:padding="12dp" />

        <!-- 9. Signature officielle -->
        <TextView
            android:id="@+id/tv_signature_hs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SERVICE OFFICIEL DE CONTRÔLE TEMPOREL"
            android:textColor="#8A806F"
            android:textSize="9sp"
            android:letterSpacing="0.08"
            android:gravity="center"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="12dp" />

    </LinearLayout>

</ScrollView>
