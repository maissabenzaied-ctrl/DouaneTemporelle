<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#263B35"
    android:padding="8dp">

    <!-- 1. Taswira 3al isar b weight 0.3 -->
    <ImageView
        android:id="@+id/img_passeport_hs"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:src="@drawable/ic_temporal_seal_hs"
        android:scaleType="fitCenter"
        android:background="#263B35"
        android:padding="5dp"
        android:contentDescription="Symbole du passeport temporel" />

    <!-- 2. Zone droite b weight 0.7 -->
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:padding="12dp"
        android:background="#F2EBDD">

        <!-- 3. Titre mta3 passeport -->
        <TextView
            android:id="@+id/tv_titre_verification_hs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PASSEPORT\nTEMPOREL"
            android:textColor="#263B35"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="10dp" />

        <!-- 4. Affichage esm el voyageur -->
        <TextView
            android:id="@+id/tv_nom_verification_hs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_titre_verification_hs"
            android:layout_marginTop="24dp"
            android:text="Nom :"
            android:textColor="#263B35"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="10dp" />

        <!-- 5. Affichage el 3omr temporel -->
        <TextView
            android:id="@+id/tv_age_verification_hs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_nom_verification_hs"
            android:text="Âge temporel :"
            android:textColor="#263B35"
            android:textSize="15sp"
            android:padding="10dp" />

        <!-- 6. Affichage sabab el voyage -->
        <TextView
            android:id="@+id/tv_motif_verification_hs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_age_verification_hs"
            android:text="Motif :"
            android:textColor="#263B35"
            android:textSize="15sp"
            android:padding="10dp" />

        <!-- 7. Bouton bech n9ablou el voyage -->
        <Button
            android:id="@+id/btn_approuver_hs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_motif_verification_hs"
            android:layout_marginTop="26dp"
            android:text="APPROUVER LE SAUT TEMPOREL"
            android:textColor="#263B35"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#B69A70"
            android:minHeight="52dp"
            android:padding="8dp" />

        <!-- 8. Bouton bech nrefdhou el voyage -->
        <Button
            android:id="@+id/btn_refuser_hs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/btn_approuver_hs"
            android:layout_marginTop="12dp"
            android:text="REFUSER LE VOYAGE"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#713F43"
            android:minHeight="52dp"
            android:padding="8dp" />

    </RelativeLayout>

</LinearLayout>
