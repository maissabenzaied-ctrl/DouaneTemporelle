<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <gradient
                android:angle="0"
                android:startColor="#243B59"
                android:endColor="#14263D"
                android:type="linear"/>
            <stroke
                android:width="1dp"
                android:color="#C6A66B"/>
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp"/>
            <stroke
                android:width="1dp"
                android:color="#35FFFFFF"/>
            <solid android:color="#08FFFFFF"/>
        </shape>
    </item>

</layer-list>